# ---------------------------------------------------------------
# 批量化产出物（不上传）：repo 只保留批量制作的工具与 SOP，
# 单独题目/课件的内容一律不进 git
# ---------------------------------------------------------------

# 每道题的备课/讲法内容（outline.json、plan.json、figure-spec、preview 等）
math_syllabus/lesson/*
!math_syllabus/lesson/README.md

# 每门课的课件源与产物（course.json、modules、pipeline、debug 页、.generated）
courses/*
!courses/README.md

# 临时调试脚本 / 可视化截图（冒烟自检产物，不入库）
engine/tmp_*
engine/.tmp-shots/
engine/tests/_shots/
engine/tests/_tmp-*

# Dependencies
node_modules/

# Engine build outputs
engine/dist/
engine/artifacts/
engine/workspace.local.json
engine/restored/

# Synced debug shell at monorepo root (from course:export)
debug/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment
.env
.env.*
!.env.example

# JetBrains IDEs
.idea/

# VS Code (local settings only)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# OS
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Editor swap / backup
*~
*.swp
*.swo
